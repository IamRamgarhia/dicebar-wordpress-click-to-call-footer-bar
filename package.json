{
	"name": "tapbar-mobile-action-bar",
	"version": "1.0.0",
	"description": "A bottom bar on phones and tablets holding whatever you put in it.",
	"license": "GPL-2.0-or-later",
	"private": true,
	"scripts": {
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"env:activate": "wp-env run cli wp plugin activate tapbar-mobile-action-bar",
		"env:install-tests": "wp-env run tests-cli --env-cwd=wp-content/plugins/tapbar-mobile-action-bar composer install",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/tapbar-mobile-action-bar vendor/bin/phpunit"
	},
	"devDependencies": {
		"@wordpress/env": "^10.0.0"
	}
}
